# MongoDB
MONGO_URI=mongodb://localhost:27017/epilepsy_db

# JWT Authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET_KEY=replace-with-strong-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-strong-random-refresh-secret

# Session Middleware
SESSION_SECRET_KEY=replace-with-strong-random-session-secret

# Google OAuth2 (optional, for Gmail report sharing)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# SMTP Email Fallback (optional)
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password

# OpenRouter LLM API (for Medical RAG Assistant)
OPENROUTER_API_KEY=your-openrouter-api-key

# App Settings
CORS_ORIGINS=http://localhost:4200
ENVIRONMENT=development
